[Unit]
Description=Language Check-in Web App
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.openclaw/workspace/apps/language-checkin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/.openclaw/workspace/apps/language-checkin/.venv/bin/gunicorn -w 2 -b 127.0.0.1:8099 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
